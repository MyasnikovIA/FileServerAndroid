{
  "http": {
    "port": 8080,
    "host": "0.0.0.0"
  },

  "https": {
    "enabled": true,
    "keystore": "assets:certs/keystore.p12",
    #"keystore": "assets:certs/keystore.p12"   → копируется из assets в кэш при первом запуске
    #"keystore": "certs/keystore.p12"          → внешний filesDir (user-writable)
    #"keystore": "/sdcard/certs/keystore.p12"  → абсолютный путь как есть
    "password": "changeit"
  },

  "web": "www",

  "autostart": {
    "jsScripts": [
      {
        "url": "js/custom-startup.js"
      }
    ],
    "wmApps": [
      {
        "id": "explorer",
        "props": {}
      }
    ]
  },
  "users": [
    {
      "name": "admin",
      "password": "admin",
      "quota": -1,
      "console": false
    }
  ],
  "shares": [
    {
      "name": "",
      "physical": "/storage/emulated/0",
      "type": "folder",
      "access": ["read", "write", "delete"],
      "anonymous": false,
      "users": ["admin"]
    }
  ]
}